# The default is a local SQLite file. For PostgreSQL, use:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/opspulse
DATABASE_URL=sqlite:///./opspulse.db

# Optional. Without this key, all analytics still work; AI requests return a
# clear setup message. Never put a real key in source control or browser code.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
